# Copy to .env.local (local) or set in your host's environment settings (production).

# Lead generation: every early-list sign-up is emailed here.
# 1. Create a free account at resend.com and verify a sending domain (e.g. medifyles.com).
# 2. Create an API key and paste it below.
RESEND_API_KEY=
# Sender address on the verified domain.
LEAD_EMAIL_FROM="Medifyles website <leads@medifyles.com>"
# Where leads go (defaults to info@medifyles.com). Prefer a dedicated inbox
# only the launch team can open, not the general one: /privacy says who can see the list.
LEAD_EMAIL_TO=info@medifyles.com

# Optional: also post each sign-up as JSON to a Google Sheet / CRM webhook.
EARLY_LIST_WEBHOOK_URL=

# "Write to us" form (/help). Uses the same RESEND_API_KEY.
# Sender on the verified domain, and the inbox that receives messages (defaults to info@medifyles.com).
# Each email's reply-to is the visitor, so the team just presses Reply.
CONTACT_EMAIL_FROM="Medifyles website <website@medifyles.com>"
CONTACT_EMAIL_TO=info@medifyles.com
